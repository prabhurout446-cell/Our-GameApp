@{
    ViewData["Title"] = "Join by Invite Code";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container" style="padding-top:40px;max-width:500px;text-align:center;">
    <div style="font-size:4rem;margin-bottom:20px;">🎟️</div>
    <h2 style="font-family:var(--font-display);font-size:2rem;font-weight:700;margin-bottom:8px;">Join Private Contest</h2>
    <p class="text-muted mb-4">Enter your invite code to join a private contest</p>
    <form asp-controller="Contest" asp-action="JoinByCode" method="get">
        <div class="form-group">
            <input name="code" class="form-control" placeholder="Enter 8-digit code (e.g. ABCD1234)"
                   maxlength="8" style="text-align:center;font-family:var(--font-display);font-size:1.3rem;letter-spacing:4px;text-transform:uppercase;"
                   required />
        </div>
        <button type="submit" class="btn btn-primary btn-lg btn-block">
            <i class="fas fa-search"></i> Find Contest
        </button>
    </form>
</div>
