@model Our11.Models.DashboardViewModel
@{
    ViewData["Title"] = "Our11 - Play Fantasy Cricket";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<div class="hero">
    <div class="container">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px;">
            <div>
                <div class="hero-title">
                    Play <span>Fantasy Cricket</span><br/>Win Real Cash 🏆
                </div>
                <p class="hero-subtitle">Create your dream team, join contests & win big with Our11</p>
                @if (!User.Identity?.IsAuthenticated ?? true)
                {
                    <div style="display:flex;gap:12px;flex-wrap:wrap;">
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">
                            <i class="fas fa-rocket"></i> Start Playing
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-secondary btn-lg">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </a>
                    </div>
                }
                else
                {
                    <div class="hero-stats">
                        <div class="hero-stat">
                            <div class="hero-stat-value">₹@Model.WalletBalance.ToString("N2")</div>
                            <div class="hero-stat-label">Wallet Balance</div>
                        </div>
                        <div class="hero-stat">
                            <div class="hero-stat-value">@Model.TotalContestsJoined</div>
                            <div class="hero-stat-label">Contests Joined</div>
                        </div>
                        <div class="hero-stat">
                            <div class="hero-stat-value">₹@Model.TotalWinnings.ToString("N2")</div>
                            <div class="hero-stat-label">Total Winnings</div>
                        </div>
                    </div>
                }
            </div>
            <div style="font-size:6rem;opacity:0.15;user-select:none;">🏏</div>
        </div>
    </div>
</div>

<div class="container" style="padding-top:24px;">

    <!-- Live Matches -->
    @if (Model.LiveMatches.Any())
    {
        <div class="mb-4">
            <div class="section-title">
                🔴 Live Matches
                <span class="badge-live">LIVE</span>
            </div>
            <div class="match-grid">
                @foreach (var m in Model.LiveMatches)
                {
                    <a asp-controller="Match" asp-action="Detail" asp-route-id="@m.Id" class="match-card">
                        <div class="match-card-header">
                            <span>@m.MatchType • @m.Sport</span>
                            <span class="status-badge status-live">● Live</span>
                        </div>
                        <div class="match-teams">
                            <div class="team-block">
                                <div class="team-name">@m.Team1</div>
                                @if (!string.IsNullOrEmpty(m.Score))
                                {
                                    <div class="team-score" data-live-match-id="@m.Id">@m.Score</div>
                                }
                            </div>
                            <div class="vs-block">
                                <div class="vs-text">VS</div>
                            </div>
                            <div class="team-block">
                                <div class="team-name">@m.Team2</div>
                            </div>
                        </div>
                        <div class="match-card-footer">
                            <span><i class="fas fa-map-marker-alt"></i> @(m.Venue.Length > 25 ? m.Venue[..25] + "..." : m.Venue)</span>
                            <span class="contest-count">Play Now</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    }

    <!-- Upcoming Matches -->
    <div class="mb-4">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
            <div class="section-title">⚡ Upcoming Matches</div>
            <a asp-controller="Match" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
        </div>
        @if (Model.UpcomingMatches.Any())
        {
            <div class="match-grid">
                @foreach (var m in Model.UpcomingMatches)
                {
                    <a asp-controller="Match" asp-action="Detail" asp-route-id="@m.Id" class="match-card">
                        <div class="match-card-header">
                            <span>@m.MatchType • @m.Sport</span>
                            <span class="status-badge status-upcoming">Upcoming</span>
                        </div>
                        <div class="match-teams">
                            <div class="team-block">
                                <div class="team-name">@m.Team1</div>
                            </div>
                            <div class="vs-block">
                                <div class="vs-text">VS</div>
                                <div style="font-size:0.7rem;color:var(--text-muted);" data-countdown="@m.StartTime.ToString("O")"></div>
                            </div>
                            <div class="team-block">
                                <div class="team-name">@m.Team2</div>
                            </div>
                        </div>
                        <div class="match-card-footer">
                            <span><i class="far fa-clock"></i> @m.StartTime.ToString("MMM d, h:mm tt")</span>
                            <span class="contest-count"><i class="fas fa-trophy"></i> Join</span>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-calendar-times"></i>
                <h4>No Upcoming Matches</h4>
                <p>Check back soon for exciting matches</p>
            </div>
        }
    </div>

    <!-- My Recent Contests -->
    @if (User.Identity?.IsAuthenticated == true && Model.MyContests.Any())
    {
        <div class="mb-4">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
                <div class="section-title">🏆 My Recent Contests</div>
                <a asp-controller="Home" asp-action="MyContests" class="btn btn-outline-primary btn-sm">View All</a>
            </div>
            <div class="card">
                @foreach (var uc in Model.MyContests)
                {
                    <div class="leaderboard-row">
                        <div style="flex:1;">
                            <div style="font-weight:600;font-size:0.9rem;">@uc.Contest.Name</div>
                            <div class="small text-muted">@uc.Contest.Match.Team1 vs @uc.Contest.Match.Team2 • @uc.UserTeam.TeamName</div>
                        </div>
                        <div style="text-align:right;">
                            @if (uc.Rank.HasValue)
                            {
                                <div class="text-primary fw-bold">Rank #@uc.Rank</div>
                                if (uc.WinningsAmount.HasValue && uc.WinningsAmount > 0)
                                {
                                    <div class="text-success small">+₹@uc.WinningsAmount.Value.ToString("N2")</div>
                                }
                            }
                            else
                            {
                                <span class="status-badge status-upcoming">Active</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- How It Works -->
    @if (!User.Identity?.IsAuthenticated ?? false)
    {
        <div class="mb-4">
            <div class="section-title text-center">How It Works</div>
            <div class="row">
                <div class="col">
                    <div class="stat-card">
                        <div style="font-size:2rem;margin-bottom:12px;">📋</div>
                        <div style="font-weight:700;font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">Select a Match</div>
                        <p class="small text-muted">Choose from upcoming cricket matches</p>
                    </div>
                </div>
                <div class="col">
                    <div class="stat-card">
                        <div style="font-size:2rem;margin-bottom:12px;">👤</div>
                        <div style="font-weight:700;font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">Build Your Team</div>
                        <p class="small text-muted">Pick 11 players within 100 credits</p>
                    </div>
                </div>
                <div class="col">
                    <div class="stat-card">
                        <div style="font-size:2rem;margin-bottom:12px;">🏆</div>
                        <div style="font-weight:700;font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">Join Contests</div>
                        <p class="small text-muted">Compete & win real cash prizes</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
