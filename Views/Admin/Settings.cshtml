@model List<Our11.Models.AppSetting>
@{
    ViewData["Title"] = "Admin - Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-layout">
    <div class="admin-sidebar d-none d-md-block">
        <div style="padding:16px 20px;font-family:var(--font-display);font-size:1.1rem;font-weight:700;color:var(--text-muted);border-bottom:1px solid var(--border);margin-bottom:8px;">ADMIN PANEL</div>
        <a asp-controller="Admin" asp-action="Index" class="admin-nav-link"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a asp-controller="Admin" asp-action="Matches" class="admin-nav-link"><i class="fas fa-calendar-alt"></i> Matches</a>
        <a asp-controller="Admin" asp-action="Contests" class="admin-nav-link"><i class="fas fa-trophy"></i> Contests</a>
        <a asp-controller="Admin" asp-action="Users" class="admin-nav-link"><i class="fas fa-users"></i> Users</a>
        <a asp-controller="Admin" asp-action="Settings" class="admin-nav-link active"><i class="fas fa-cog"></i> Settings</a>
        <hr style="border-color:var(--border);margin:12px 0;">
        <a asp-controller="Home" asp-action="Index" class="admin-nav-link"><i class="fas fa-home"></i> Back to Site</a>
    </div>
    <div class="admin-content" style="max-width:800px;">
        <div class="page-title mb-4"><i class="fas fa-cog text-primary"></i> Platform Settings</div>
        <div style="display:grid;gap:16px;">
            @foreach (var s in Model)
            {
                <div class="card">
                    <div class="card-body" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
                        <div style="flex:1;">
                            <div style="font-weight:700;font-size:0.95rem;">@s.Key</div>
                            <div class="small text-muted">@s.Description</div>
                            <div style="font-size:0.72rem;color:var(--text-muted);margin-top:2px;">Last updated: @s.UpdatedAt.ToString("MMM d, yyyy")</div>
                        </div>
                        <form asp-action="UpdateSetting" method="post" style="display:flex;gap:8px;align-items:center;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.Id" />
                            <input type="text" name="value" class="form-control" value="@s.Value" style="max-width:120px;" required />
                            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-save"></i> Save</button>
                        </form>
                    </div>
                </div>
            }
        </div>
        <div style="margin-top:24px;padding:16px;background:var(--dark-3);border-radius:var(--radius);font-size:0.82rem;color:var(--text-muted);">
            <i class="fas fa-exclamation-triangle text-warning"></i>
            <strong>Important:</strong> CommissionPct changes only apply to <em>new</em> contests. Existing contests retain their original commission rate.
        </div>
    </div>
</div>
