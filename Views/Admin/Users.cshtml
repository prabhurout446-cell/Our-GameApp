@model List<Our11.Models.ApplicationUser>
@{
    ViewData["Title"] = "Admin - Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-layout">
    <div class="admin-sidebar d-none d-md-block">
        <div style="padding:16px 20px;font-family:var(--font-display);font-size:1.1rem;font-weight:700;color:var(--text-muted);border-bottom:1px solid var(--border);margin-bottom:8px;">ADMIN PANEL</div>
        <a asp-controller="Admin" asp-action="Index" class="admin-nav-link"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a asp-controller="Admin" asp-action="Matches" class="admin-nav-link"><i class="fas fa-calendar-alt"></i> Matches</a>
        <a asp-controller="Admin" asp-action="Contests" class="admin-nav-link"><i class="fas fa-trophy"></i> Contests</a>
        <a asp-controller="Admin" asp-action="Users" class="admin-nav-link active"><i class="fas fa-users"></i> Users</a>
        <a asp-controller="Admin" asp-action="Settings" class="admin-nav-link"><i class="fas fa-cog"></i> Settings</a>
        <hr style="border-color:var(--border);margin:12px 0;">
        <a asp-controller="Home" asp-action="Index" class="admin-nav-link"><i class="fas fa-home"></i> Back to Site</a>
    </div>
    <div class="admin-content">
        <div class="page-title mb-4"><i class="fas fa-users text-primary"></i> All Users (@Model.Count)</div>
        <div class="card">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr><th>Name</th><th>Email</th><th>Phone</th><th>Wallet</th><th>Joined</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.OrderByDescending(u => u.CreatedAt))
                        {
                            <tr>
                                <td>
                                    <div style="display:flex;align-items:center;gap:10px;">
                                        <div style="width:34px;height:34px;border-radius:50%;background:var(--dark-4);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.85rem;color:var(--primary);">
                                            @u.FullName[0]
                                        </div>
                                        <strong>@u.FullName</strong>
                                    </div>
                                </td>
                                <td class="small">@u.Email</td>
                                <td class="small">@u.PhoneNumber</td>
                                <td style="color:var(--primary);font-weight:700;">₹@u.WalletBalance.ToString("N2")</td>
                                <td class="small">@u.CreatedAt.ToString("MMM d, yyyy")</td>
                                @{
                                    var uStatusClass = u.IsActive ? "status-badge status-upcoming" : "status-badge status-completed";
                                    var uStatusText  = u.IsActive ? "Active" : "Inactive";
                                    var uBtnClass    = u.IsActive ? "btn btn-sm btn-danger" : "btn btn-sm btn-outline-primary";
                                    var uBtnText     = u.IsActive ? "Deactivate" : "Activate";
                                }
                                <td>
                                    <span class="@uStatusClass">@uStatusText</span>
                                </td>
                                <td>
                                    <form asp-action="ToggleUser" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="@uBtnClass">@uBtnText</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
