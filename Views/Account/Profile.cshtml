@model Our11.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="padding-top:24px;padding-bottom:40px;max-width:700px;">
    <div class="page-title mb-4">👤 My Profile</div>

    <!-- Profile Card -->
    <div class="card mb-4" style="border:1px solid rgba(212,245,42,0.15);">
        <div class="card-body" style="padding:28px;">
            <div style="display:flex;align-items:center;gap:20px;margin-bottom:24px;flex-wrap:wrap;">
                <div style="width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:700;color:var(--dark);flex-shrink:0;">
                    @Model.FullName[0]
                </div>
                <div>
                    <div style="font-family:var(--font-display);font-size:1.5rem;font-weight:700;">@Model.FullName</div>
                    <div class="text-muted small">@Model.Email</div>
                    <div class="text-muted small">Joined: @Model.CreatedAt.ToString("MMMM yyyy")</div>
                </div>
            </div>

            <div class="stat-grid mb-4">
                <div class="stat-card">
                    <div class="stat-value">₹@Model.WalletBalance.ToString("N2")</div>
                    <div class="stat-label">Wallet Balance</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@(Model.IsActive ? "✓" : "✗")</div>
                    <div class="stat-label">Account Active</div>
                </div>
            </div>

            <form asp-controller="Account" asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label">Full Name</label>
                    <input type="text" name="fullName" class="form-control" value="@Model.FullName" required maxlength="100" />
                </div>
                <div class="form-group">
                    <label class="form-label">Email <span class="text-muted small">(cannot change)</span></label>
                    <input type="email" class="form-control" value="@Model.Email" disabled />
                </div>
                <div class="form-group">
                    <label class="form-label">Phone Number</label>
                    <input type="text" name="phoneNumber" class="form-control" value="@Model.PhoneNumber" placeholder="+91 XXXXXXXXXX" />
                </div>
                <div style="display:flex;gap:10px;margin-top:20px;">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Changes</button>
                    <a asp-controller="Home" asp-action="Wallet" class="btn btn-outline-primary"><i class="fas fa-wallet"></i> My Wallet</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="card">
        <div class="card-header">Quick Links</div>
        <div class="card-body" style="padding:12px;">
            <a asp-controller="Home" asp-action="MyContests" style="display:flex;align-items:center;gap:12px;padding:12px;border-radius:8px;color:var(--text) !important;transition:var(--transition);" onmouseover="this.style.background='var(--dark-3)'" onmouseout="this.style.background=''">
                <i class="fas fa-trophy text-primary fa-fw"></i>
                <div>
                    <div style="font-weight:600;font-size:0.9rem;">My Contests</div>
                    <div class="small text-muted">View all active and completed contests</div>
                </div>
                <i class="fas fa-chevron-right text-muted" style="margin-left:auto;"></i>
            </a>
            <a asp-controller="Home" asp-action="Wallet" style="display:flex;align-items:center;gap:12px;padding:12px;border-radius:8px;color:var(--text) !important;transition:var(--transition);" onmouseover="this.style.background='var(--dark-3)'" onmouseout="this.style.background=''">
                <i class="fas fa-wallet text-primary fa-fw"></i>
                <div>
                    <div style="font-weight:600;font-size:0.9rem;">Wallet & Transactions</div>
                    <div class="small text-muted">Manage your balance</div>
                </div>
                <i class="fas fa-chevron-right text-muted" style="margin-left:auto;"></i>
            </a>
            <a asp-controller="Match" asp-action="Index" style="display:flex;align-items:center;gap:12px;padding:12px;border-radius:8px;color:var(--text) !important;transition:var(--transition);" onmouseover="this.style.background='var(--dark-3)'" onmouseout="this.style.background=''">
                <i class="fas fa-calendar-alt text-primary fa-fw"></i>
                <div>
                    <div style="font-weight:600;font-size:0.9rem;">Browse Matches</div>
                    <div class="small text-muted">Join contests on upcoming matches</div>
                </div>
                <i class="fas fa-chevron-right text-muted" style="margin-left:auto;"></i>
            </a>
        </div>
    </div>
</div>
